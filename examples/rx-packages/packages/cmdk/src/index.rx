// The command menu. Derived from cmdk-solid 2.0.0-rc.0 (MIT, see ../NOTICE), without its Dialog (Kobalte's).
import { give, call, textOf, firstValue, step, pressSelected, reveal, listHeight } from "./dom.js"
import client { onResize } from "@reactivescript/std/browser"
import { keys } from "@reactivescript/std/object"
import pure { uniqueId, one } from "./dom.js"
import { HIDDEN } from "./dom.js"
import { commandScore } from "./score.js"
import { Div, Input as InputProps } from "./types.js"

type Known = { value: string; keywords: string[] | undefined; group: string | undefined; force: boolean; disabled: boolean }
type Menu = { search: string; value: string; scores: { [id: string]: number }; groups: string[]; count: number; filters: boolean; label: string; pointer: boolean; list: any; active: string | undefined; ids: { list: string; input: string; label: string }
  add: (id: string, k: Known | undefined) => void; pick: (v: string) => void; find: (s: string) => void; listRef: (e: any) => void; settle: () => void }
context menu: Menu
context group: { id: string | undefined; force: boolean } = { id: undefined, force: false }

export type CommandProps = Omit<Div, "value"> & { label?: string; shouldFilter?: boolean; filter?: (value: string, search: string, keywords?: string[]) => number; defaultValue?: string; value?: string; onValueChange?: (v: string) => void; loop?: boolean; disablePointerSelection?: boolean; vimBindings?: boolean }
export component Command(props: CommandProps) {
  { label, shouldFilter = true, filter, defaultValue, value, onValueChange, loop = false, disablePointerSelection = false, vimBindings = true, onKeyDown, children, ...rest } = props
  list_ = uniqueId()
  input = uniqueId()
  label_ = uniqueId()
  source search := ""
  source mine := peek(defaultValue) ?? ""
  source known: { [id: string]: Known | undefined } := {}
  source el: any := undefined
  now = value ?? mine
  ids = keys(known).filter(id => known[id] != undefined)
  score = filter ?? commandScore
  scores = Object_(ids.map(id => ({ id: id, n: search == "" || !shouldFilter ? 1 : of(known[id], search, score) })))
  shown = ids.filter(id => (scores[id] ?? 0) > 0)
  groups = shown.map(id => (known[id])?.group)
  action add(id: string, k: Known | undefined) { known[id] := k }
  action pick(v: string) { if (v != now) { mine := v
    if (onValueChange) { onValueChange(v) } } }
  action first() { pick(firstValue(el) ?? "") }
  action find(s: string) { search := s }
  action listRef(e: any) { el := e }
  action settle() { if (now == "" || !ids.some(id => (known[id])?.value == now && (scores[id] ?? 0) > 0)) { first() } }
  action go(e: KeyboardEvent, how: string) { e.preventDefault(); let v = step(el, how, loop); if (v != undefined) { pick(v) } }
  effect (search) { first() }
  effect (now) { reveal(el) }
  provide menu = { search: search, value: now, scores: scores, groups: groups.filter(g => g != undefined), count: shown.length, filters: shouldFilter, label: label ?? "", pointer: !disablePointerSelection, list: el, active: ids.find(id => (known[id])?.value == now && now != ""), ids: { list: list_, input: input, label: label_ }, add: add, pick: pick, find: find, listRef: listRef, settle: settle }
  <div tabindex={0 - 1} {...rest} cmdk-root="" onKeyDown={(e) => { call(e, onKeyDown)
    if (!e.defaultPrevented) {
      if (e.key == "ArrowDown" || (vimBindings && e.ctrlKey && (e.key == "n" || e.key == "j"))) { go(e, e.metaKey ? "last" : e.altKey ? "group-next" : "next") }
      else if (e.key == "ArrowUp" || (vimBindings && e.ctrlKey && (e.key == "p" || e.key == "k"))) { go(e, e.metaKey ? "first" : e.altKey ? "group-prev" : "prev") }
      else if (e.key == "Home") { go(e, "first") } else if (e.key == "End") { go(e, "last") }
      else if (e.key == "Enter" && !e.isComposing) { e.preventDefault(); pressSelected(el) }
    } }}>
    <label cmdk-label="" for={input} id={label_} style={HIDDEN}>{label ?? ""}</label>{children}</div>
}
fn of(k: Known | undefined, search: string, score: (value: string, search: string, keywords?: string[]) => number): number => k == undefined || k.value == "" ? 0 : score(k.value, search, k.keywords)
fn Object_(xs: { id: string; n: number }[]): { [id: string]: number } => xs.reduce((o: { [id: string]: number }, x: { id: string; n: number }) => ({ ...o, ...one(x) }), {})

export component Item(props: Omit<Div, "onSelect"> & { value?: string; keywords?: string[]; disabled?: boolean; forceMount?: boolean; onSelect?: (v: string) => void }) {
  { value, keywords, disabled = false, forceMount, onSelect, children, ref: user, ...rest } = props
  m = use menu
  g = use group
  id = uniqueId()
  source el: any := undefined
  source text := ""
  mine = value ?? text
  force = forceMount ?? g.force
  effect (el) { if ($0) { text := textOf($0) } }
  effect (mine, keywords, g.id, force, disabled) { m.add(id, { value: $0, keywords: $1, group: $2, force: $3, disabled: $4 }); m.settle(); return () => { m.add(id, undefined); m.settle() } }
  on_ = mine != "" && mine == m.value
  action select() { m.pick(mine)
    if (onSelect) { onSelect(mine) } }
  {if force || !m.filters || m.search == "" || text == "" || (m.scores[id] ?? 0) > 0 {
    <div {...rest} ref={(e: Element) => { el := e; give(user, e) }} id={id} cmdk-item="" role="option" data-value={mine} aria-disabled={disabled ? "true" : "false"} aria-selected={on_ ? "true" : "false"} data-disabled={disabled ? "true" : "false"} data-selected={on_ ? "true" : "false"}
      onPointerMove={() => { if (!disabled && m.pointer) { m.pick(mine) } }} onClick={() => { if (!disabled) { select() } }}>{children}</div>
  }}
}
export component Group(props: Div & { heading?: View; value?: string; forceMount?: boolean }) {
  { heading: none, value, forceMount = false, children, ref: user, ...rest } = props
  m = use menu
  id = uniqueId()
  head = uniqueId()
  source text := ""
  source hd: any := undefined
  effect (hd) { if ($0) { text := textOf($0) } }
  provide group = { id: id, force: forceMount }
  <div ref={(e: Element) => { give(user, e) }} {...rest} cmdk-group="" id={id} role="presentation" data-value={value ?? text} hidden={forceMount || !m.filters || m.search == "" || m.groups.includes(id) ? undefined : true}>
    {if props.heading { <div cmdk-group-heading="" ref={(e: Element) => { hd := e }} aria-hidden="true" id={head}>{props.heading}</div> }}
    <div cmdk-group-items="" role="group" aria-labelledby={props.heading ? head : undefined}>{children}</div>
  </div>
}
export component Separator(props: Div & { alwaysRender?: boolean }) {
  { alwaysRender = false, children: none, ...rest } = props
  m = use menu
  {if alwaysRender || m.search == "" { <div {...rest} cmdk-separator="" role="separator" /> }}
}
export component Input(props: Omit<InputProps, "value"> & { value?: string; onValueChange?: (v: string) => void }) {
  { value, onValueChange, ref: user, ...rest } = props
  m = use menu
  effect (value) { if ($0 != undefined) { m.find($0) } }
  <input {...rest} ref={(e: Element) => { give(user, e) }} cmdk-input="" autocomplete="off" autocorrect="off" spellcheck={false} aria-autocomplete="list" role="combobox" aria-expanded="true" aria-controls={m.ids.list} aria-labelledby={m.ids.label} aria-activedescendant={m.active} id={m.ids.input} type="text" value={value ?? m.search}
    onInput={(e) => { if (value == undefined) { m.find(e.currentTarget.value) }
      if (onValueChange) { onValueChange(e.currentTarget.value) } }} />
}
export component List(props: Div & { label?: string }) {
  { label = "Suggestions", children, ref: user, ...rest } = props
  m = use menu
  source outer: any := undefined
  effect (outer, m.list) { let a = $0
    let b = $1
    return a && b ? onResize(b, () => { listHeight(a, b) }) : undefined }
  <div ref={(e: Element) => { outer := e; give(user, e) }} {...rest} cmdk-list="" role="listbox" aria-label={label} id={m.ids.list}><div ref={(e: Element) => { m.listRef(e) }} cmdk-list-sizer="">{children}</div></div>
}
export component Empty(props: Div) {
  { children, ...rest } = props
  m = use menu
  source mounted := false
  effect () { mounted := true }
  {if mounted && m.count == 0 { <div {...rest} cmdk-empty="" role="presentation">{children}</div> }}
}
export component Loading(props: Div & { progress?: number; label?: string }) {
  { progress, label = "Loading...", children, ...rest } = props
  <div {...rest} cmdk-loading="" role="progressbar" aria-valuenow={progress} aria-valuemin={0} aria-valuemax={100} aria-label={label}><div aria-hidden="true">{children}</div></div>
}
