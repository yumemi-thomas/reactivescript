type State = { value: string; on: boolean; mixed: boolean; toggle: () => void; check: (v: boolean) => void; focused: (v: boolean) => void; input: (e: any) => void }
context box: State
fn data(s: State) => ({ "data-checked": flag(s.on), "data-indeterminate": flag(s.mixed) })

export type RootProps = Omit<Div, "children"> & { children?: View | ((s: { checked: boolean; indeterminate: boolean }) => View); value?: string; checked?: boolean; defaultChecked?: boolean; indeterminate?: boolean; onChange?: (checked: boolean) => void
  name?: string; validationState?: Validation; required?: boolean; disabled?: boolean; readOnly?: boolean }
export component Root(props: RootProps) {
  { value = "on", checked, defaultChecked, indeterminate = false, onChange, onPointerDown, name, validationState, required, disabled, readOnly, id, children: shown, ref: user, ...rest } = props
  f = createForm({ id: id, name: name, validationState: validationState, required: required, disabled: disabled, readOnly: readOnly }, "checkbox")
  source mine := peek(defaultChecked) ?? false
  source el: any := undefined
  source inputEl: any := undefined
  source focused := false
