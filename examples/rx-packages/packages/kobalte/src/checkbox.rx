    style={hidden(style)} aria-labelledby={field.by} aria-describedby={field.described}
    aria-invalid={f.invalid ? "true" : undefined} aria-required={f.required ? "true" : undefined} aria-disabled={f.disabled ? "true" : undefined} aria-readonly={f.readOnly ? "true" : undefined}
    onChange={(e) => { call(e, onChange); e.stopPropagation(); if (!telling) { s.check(e.currentTarget.checked); put(e.currentTarget, "checked", s.on) } }} onFocus={(e) => { call(e, onFocus); s.focused(true) }} onBlur={(e) => { call(e, onBlur); s.focused(false) }}
    {...f.data} {...data(s)} />
