// The headless virtualizer (@tanstack/solid-virtual's createVirtualizer, ported to Solid 2.0): the app renders the rows,
// and hands the scroll element over with `ref` (07 §4), read back through the declared callback getScrollElement (MO-10g).
import { createVirtualizer } from "./virtualizer.js"
import { makeRows } from "./rows.js"

export default component App() {
  rows = makeRows(10000)
  source scroller := null
  { items, totalSize, scrollToIndex } = createVirtualizer({ count: rows.length, getScrollElement: () => scroller, estimateSize: i => 30 })
  <button id="jump" onClick={() => { scrollToIndex(7000) }}>jump</button>
  <div class="vlist" ref={el => { scroller := el }} style="height:300px;overflow:auto">
    <div style={`height:${totalSize}px;position:relative`}>
      {for item in items {
        <div class="vrow" style={`position:absolute;top:0;left:0;width:100%;height:30px;transform:translateY(${item.start}px)`}>{rows[item.index]}</div>
      }}
    </div>
  </div>
}
