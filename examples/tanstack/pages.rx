// The root layout and the pages, which the route files render (routes/). The layout is written as TanStack's own
// documentation writes one: it renders its pages with <Outlet />, and its typed `errored` region holds what a page
// fails with — host.d.rx says the pages are rendered there.
import { Link, Outlet, useNavigate, useParams } from "@tanstack/solid-router"
import { fetchPerson, NotFound } from "./people.js"
import { team } from "./team.rx"

export component Root() {
  <nav><Link to="/">Home</Link> <Link to="/people/$id" params={{ id: "1" }}>Ann</Link> <Link to="/people/$id" params={{ id: "2" }}>Bo</Link> <Link to="/people/$id" params={{ id: "9" }}>Nobody</Link></nav>
  errored fallback(e: NotFound) { <p class="missing">{e.message}</p> } {
    <main><Outlet /></main>
  }
}
export component Home() {
  t = use team
  navigate = useNavigate()
  <h1>People</h1>
  <p class="of">of {t.name}</p>
  <button onClick={() => { navigate({ to: "/people/$id", params: { id: "2" } }) }}>Meet Bo</button>
}
export component Person() {
  params = useParams({ from: "/people/$id" })
  person = await fetchPerson(params.id)
  loading fallback { <p>loading…</p> } {
    <h1>{person.name}</h1>
    <p>{person.role}, #{params.id}</p>
  }
}
