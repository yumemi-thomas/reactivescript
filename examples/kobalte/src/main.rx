// Kobalte's Dialog from .rx: compound parts as dotted tags (MO-11q), the kit's stylesheet imported for its effect (07 §1a)
import "./app.css"
import { Dialog } from "./kobalte.js"

source opened := 0

export default component App() {
  <h1>Kobalte</h1>
  <p class="count">opened {opened}</p>
  <Dialog onOpenChange={(open) => { if (open) { opened := opened + 1 } }}>
    <Dialog.Trigger class="trigger">Open</Dialog.Trigger>
    <Dialog.Portal>
      <Dialog.Overlay class="overlay" />
      <Dialog.Content class="content">
        <Dialog.Title>Hello</Dialog.Title>
        <p>from .rx</p>
        <Dialog.CloseButton class="close">Close</Dialog.CloseButton>
      </Dialog.Content>
    </Dialog.Portal>
  </Dialog>
}
