export component TabsPanel(props: TabsPanelProps) {
  { value, keepMounted, hiddenUntilFound, render, ref: user, ...rest } = props
  scope = use tabs
  named = { value: value, keepMounted: keepMounted, hiddenUntilFound: hiddenUntilFound }
  { part, attrs, now, tick } = usePart(scope.it, "panel", named, rest, scope.options)
  present = presentOf(part, named, scope.options, tick)
  {if present {
    bind = binder(part)
    on_ = own({ ref: (e: Element) => { bind(e); give(user, e) } })
    {if render != undefined {
      all = elementProps(rest, { ...attrs, ...on_, class: classOf(props.class, now), style: styleOf(props.style, now, attrs.style) }, peek props, peek now)
      {viewOf(render(all, now))}
    } else {
      <div {...rest} {...attrs} {...on_} class={classOf(props.class, now)} style={styleOf(props.style, now, attrs.style)}>{viewOf(props.children, now)}</div>
    }}
  }}
}
