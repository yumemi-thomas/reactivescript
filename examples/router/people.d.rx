export type Person = { name: string; role: string }
export error NotFound
export pure fn fetchPerson(id: string): Promise<Person> rejects(NotFound)
// the router's data layer, made in JS and declared with its rows: a query is the fn it caches, with the same rows
export pure fn getPerson(id: string): Promise<Person> rejects(NotFound)
// a form action: bound to a <form action={…}>, its submissions read with useSubmissions (router.d.rx)
export const promoteForm: any
