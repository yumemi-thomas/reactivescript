// The router's factory, route helper and hooks, in rows (MO-11, MO-12). Types are @solidjs/router's own, as TypeScript text.
export type RouteParams<S> = import("@solidjs/router").RouteParams<S>
export type RouteDefinition = import("@solidjs/router").RouteDefinition
export context router                                                                  // MO-12a: the router's own context
export pure fn createRouter(config: { routes: RouteDefinition[] }): Component provides(router) nests(children in component)   // MO-12c, MO-11i
export pure fn defineRoute<const S extends string | readonly string[]>(route: { path: S; component?: Component<{ params: RouteParams<S>; children?: View }>; children?: RouteDefinition[] }): RouteDefinition   // MO-8d, MO-11g
export pure fn useParams(): Record<string, string | undefined> uses(router)            // MO-12b: refused where no router is above
export pure fn useNavigate(): (to: string) => void uses(router)
