// Formisch in rows (drafted by rx-declare from @formisch/solid/v2, kept to what main.rx uses), and valibot's builders
//@ for @formisch/solid ^1.3.0
export component Field(props: { of: any; path: any; children: (store: any) => View })
export component Form(props: { of: any; children: View; onSubmit: (output: any, event: any) => any })
export pure fn createForm(config: any): any instantiates
export pure fn object(entries: any): any
export pure fn string(): any
export pure fn pipe(...items: any[]): any
export pure fn isEmail(message?: string): any
export pure fn minLength(n: number, message?: string): any
