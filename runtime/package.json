{
  "name": "@reactivescript/runtime",
  "description": "ReactiveScript's runtime (spec/11 CP-4a): createApp and the __rt helpers compiled .rx calls, over Solid, for the browser and the server",
  "version": "0.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/reactivescript.git",
    "directory": "runtime"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "worker": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "browser": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "deno": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "node": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./rx-lib": {
      "types": "./rx-lib.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "rx-lib.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs && node pack.mjs strip",
    "test": "node test.mjs",
    "postpack": "node pack.mjs restore"
  },
  "peerDependencies": {
    "@solidjs/signals": "^2.0.4",
    "@solidjs/web": "^2.0.4",
    "solid-js": "^2.0.4"
  },
  "devDependencies": {
    "@solidjs/signals": "file:../../solid-next/packages/signals",
    "@solidjs/web": "file:../../solid-next/packages/web",
    "rolldown": "1.2.19",
    "solid-js": "file:../../solid-next/packages/solid",
    "tsrs": "7.1.0-beta.tsrs5"
  }
}
