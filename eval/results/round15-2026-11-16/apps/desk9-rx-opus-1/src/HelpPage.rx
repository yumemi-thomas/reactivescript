import pure { search, fetchItem } from "./api"

export component HelpPage(props: { seedQuery: string; seedId: number | null }) {
  source query: string := peek(props.seedQuery)
  source picked: number | null := peek(props.seedId)

  results = query.length < 2 ? [] : await search(query)
  item = picked == null ? null : await fetchItem(picked)
  pickedId = picked ?? 0

  <section>
    <input data-testid="query" value={query} onInput={(e) => { query := e.target.value }} />
    <div data-testid="results">
      {if query.length == 1 {
        <p>too short: {query}</p>
      } else if query.length >= 2 {
        <div>
          {loading fallback { <p>searching…</p> } {
            {errored fallback(e) { <p>search failed: {e.message}</p> } {
              {if pending? results { <p>searching…</p> }}
              <p>{results.length} results for {query}</p>
              <ul>
                {for h in results {
                  <li data-testid="hit" onClick={() => { picked := h.id }}>{(picked == h.id ? "> " : "") + h.name}</li>
                }}
              </ul>
            }}
          }}
        </div>
      }}
    </div>
    <div data-testid="item">
      {if picked == null {
        <p>pick a result</p>
      } else {
        <div>
          {loading on(picked) fallback { <p>loading…</p> } {
            {errored fallback(e) {
              <p>failed: {e.message}</p>
              <button data-testid="retry-item" onClick={() => { refresh item }}>retry</button>
            } {
              {if item == null {
                <p>item {pickedId} not found</p>
              } else {
                <h3>{item?.name}</h3>
                <p>{item?.blurb}</p>
              }}
            }}
          }}
        </div>
      }}
    </div>
  </section>
}
