import pure { search } from "./api"
import {
  filter, selected, rows, detailAns, heading, commentsAns, shownPosting, shownLabels,
  assignErr, renameErr, closeErr, postErr, labelErr, rowErr,
  setFilter, selectIssue, setOpenCount, retryDetail,
  assignIssue, rename, close, post, addIssueLabel, removeIssueLabel,
} from "./issues.rx"

// Copies the open list's row count to the tab; lives inside the list's region, so it follows what the rows show.
component OpenCount(props: { n: number }) {
  effect (props.n) { setOpenCount($0) }
  <span hidden></span>
}

component Related(props: { title: string; onOpen: (q: string, id: number) => void }) {
  hits = await search(props.title)
  <div data-testid="related">
    {loading on(props.title) fallback { <p>finding related help</p> } {
      {errored fallback(e) { <p>related help failed: {e.message}</p> } {
        {if hits.length == 0 {
          <p>no related help</p>
        } else {
          {for h in hits.slice(0, 3) {
            <button data-testid="related-hit" onClick={() => { props.onOpen(props.title, h.id) }}>{h.name}</button>
          }}
        }}
      }}
    }}
  </div>
}

export component IssuesPage(props: { onOpenHelp: (q: string, id: number) => void }) {
  source user := "guest"
  source titleText := ""
  source commentText := ""
  source labelText := ""

  <section>
    <label>user <input data-testid="user" value={user} onInput={(e) => { user := e.target.value }} /></label>
    <div>
      <button data-testid="filter-open" onClick={() => { setFilter("open") }}>open</button>{" "}
      <button data-testid="filter-closed" onClick={() => { setFilter("closed") }}>closed</button>
    </div>

    <div data-testid="list">
      {loading on(filter) fallback { <p>loading {latest filter} issues</p> } {
        {errored fallback(e) { <p>list error: {e.message}</p> } {
          {if filter == "open" { <OpenCount n={rows.length} /> }}
          <ul>
            {for it in rows {
              <li>
                <span data-testid="issue" onClick={() => {
                  titleText := ""
                  commentText := ""
                  labelText := ""
                  selectIssue(it.id)
                }}>#{it.id} {it.title} ({it.assignee ?? "unassigned"})</span>{" "}
                <button data-testid="row-assign" onClick={() => { assignIssue(it.id, user, true) }}>assign to {user}</button>
                {if filter == "open" {
                  {" "}<button data-testid="row-close" onClick={() => { close(it.id, true) }}>close</button>
                }}
              </li>
            }}
          </ul>
        }}
      }}
    </div>
    {if rowErr != "" { <p data-testid="row-error">row error: {rowErr}</p> }}

    <div data-testid="detail">
      {if selected == null {
        <p>select an issue</p>
      } else {
        id = selected ?? 0
        {loading on(selected) fallback { <p>loading #{id}</p> } {
          {errored fallback(e) { <p>detail error: {e.message}</p> } {
            {if detailAns == null {
              <p>detail error: issue #{id} not found</p>
            } else {
              <h2>#{detailAns.id} {heading}</h2>
              <p>{detailAns.body}</p>
              <Related title={detailAns.title} onOpen={(q, h) => { props.onOpenHelp(q, h) }} />
            }}
          }}
        }}
        <button data-testid="retry" onClick={() => { retryDetail() }}>retry</button>

        <div>
          <button data-testid="assign" onClick={() => { assignIssue(id, user, false) }}>assign to {user}</button>
          {if assignErr.id == id && assignErr.msg != "" { <p data-testid="assign-error">{assignErr.msg}</p> }}
        </div>

        <div>
          <input data-testid="title-input" value={titleText} onInput={(e) => { titleText := e.target.value }} />{" "}
          <button data-testid="rename" onClick={() => {
            let t = titleText.trim()
            if (t != "") { rename(id, t) }
          }}>rename</button>
          {if renameErr.id == id && renameErr.msg != "" { <p data-testid="rename-error">rename error: {renameErr.msg}</p> }}
        </div>

        <div>
          <button data-testid="close" onClick={() => { close(id, false) }}>close</button>
          {if closeErr.id == id && closeErr.msg != "" { <p data-testid="close-error">close error: {closeErr.msg}</p> }}
        </div>

        <div data-testid="comments">
          {loading on(selected) fallback { <p>loading comments</p> } {
            {errored fallback(e) { <p>comments error: {e.message}</p> } {
              <ul>
                {for c in commentsAns {
                  <li data-testid="comment">{c.author}: {c.text}</li>
                }}
                {for p in shownPosting {
                  <li data-testid="comment">{p.author}: {p.text} (sending…)</li>
                }}
              </ul>
            }}
          }}
        </div>
        <div>
          <input data-testid="comment-input" value={commentText} onInput={(e) => { commentText := e.target.value }} />{" "}
          <button data-testid="post" onClick={() => {
            let t = commentText
            if (t.trim() != "") {
              onFlush(() => { commentText := "" })
              post(id, user, t)
            }
          }}>post</button>
          {if postErr.id == id && postErr.msg != "" { <p data-testid="post-error">post error: {postErr.msg}</p> }}
        </div>

        <div data-testid="labels">
          {loading on(selected) fallback { <p>loading labels</p> } {
            {errored fallback(e) { <p>labels error: {e.message}</p> } {
              <ul>
                {for l in shownLabels {
                  <li>
                    <span data-testid="label">{l}</span>{" "}
                    <button data-testid="remove-label" onClick={() => { removeIssueLabel(id, l) }}>remove {l}</button>
                  </li>
                }}
              </ul>
              <input data-testid="label-input" value={labelText} onInput={(e) => { labelText := e.target.value }} />{" "}
              <button data-testid="add-label" onClick={() => {
                let l = labelText.trim()
                if (l != "" && !shownLabels.includes(l)) {
                  onFlush(() => { labelText := "" })
                  addIssueLabel(id, l)
                }
              }}>add label</button>
            }}
          }}
        </div>
        {if labelErr.id == id && labelErr.msg != "" { <p data-testid="label-error">label error: {labelErr.msg}</p> }}
      }}
    </div>
  </section>
}
