import pure { fetchIssues, fetchIssue, fetchComments, fetchLabels, search, fetchItem, loadSettings } from "./api"
import { assign, renameIssue, closeIssue, addComment, addLabel, removeLabel, saveSettings } from "./api"
import { Settings } from "./api"

// ---- state that outlives a page ----
source page: string := "issues"
source handoffQ: string := ""        // a related hit opens the help page with this query ...
source handoffId: number := 0        // ... and this hit selected
source openKnown: boolean := false   // the open list has answered at least once
source openIds: number[] := []       // ids in the open list at its last answer
source closedOk: number[] := []      // closes the server accepted since that answer
source closing: number[] = []        // closes in flight (a guess)

fn renamedTitle(rs, id: number, t: string) => rs.reduce((n, r) => r.id == id ? r.title : n, t)
fn assignedTo(xs, id: number, a: string | null) => xs.reduce((n, r) => r.id == id ? r.assignee : n, a)

action noteOpen(ids: number[]) {
  openIds := ids
  openKnown := true
  closedOk := []
}

countNow = openIds.filter(i => !closedOk.some(c => c == i) && !closing.some(c => c == i)).length
issuesLabel = openKnown ? `Issues (${countNow})` : "Issues"

component RelatedHelp(props: { title: string }) {
  hits = await search(props.title)
  firstHits = hits.filter((h, i) => i < 3)
  <div data-testid="related">
    {loading fallback { <p>finding related help</p> } {
      {errored fallback(e) { <p>related help failed: {e.message}</p> } {
        {if hits.length == 0 {
          <p>no related help</p>
        } else {
          <div>
            {for h in firstHits {
              <button data-testid="related-hit" onClick={() => { handoffQ := props.title; handoffId := h.id; onFlush(() => { page := "help" }) }}>{h.name}</button>
            }}
          </div>
        }}
      }}
    }}
  </div>
}

component NoteOpen(props: { ids: number[]; open: boolean }) {
  effect (props.ids, props.open) {
    if ($1) { noteOpen($0) }
  }
  <span></span>
}

component IssuesPage() {
  source who: string := "guest"
  source filter: string := "open"
  source sel: number := 0
  source titleDraft: string := ""
  source commentDraft: string := ""
  source labelDraft: string := ""
  source assigning: { id: number; assignee: string }[] = []
  source assignedOk: { id: number; assignee: string }[] := []
  source renaming: { id: number; title: string }[] = []
  source renamedOk: { id: number; title: string }[] := []
  source sendingC: { id: number; author: string; text: string }[] = []
  source addingL: { id: number; label: string }[] = []
  source removingL: { id: number; label: string }[] = []
  source assignErr: string := ""
  source renameErr: string := ""
  source closeErr: string := ""
  source postErr: string := ""
  source labelErr: string := ""
  source rowErr: string := ""

  issues = await fetchIssues(filter)

  shownRows key id = issues.filter(i => filter != "open" || !(closing.some(c => c == i.id) || closedOk.some(c => c == i.id))).map(i => ({ id: i.id, title: renamedTitle([...renamedOk, ...renaming], i.id, i.title), assignee: assignedTo([...assignedOk, ...assigning], i.id, i.assignee) }))

  detailQ = sel > 0 ? await fetchIssue(sel) : null
  shownTitle = detailQ == null ? "" : renamedTitle([...renamedOk, ...renaming], sel, detailQ.title)
  commentsQ = sel > 0 ? await fetchComments(sel) : []
  labelsQ = sel > 0 ? await fetchLabels(sel) : []
  sendingRows = sendingC.filter(c => c.id == sel)
  labelsShown = [...labelsQ.filter(l => !removingL.some(r => r.id == sel && r.label == l)), ...addingL.filter(a => a.id == sel).map(a => a.label)]

  action pickIssue(id: number) {
    sel := id
    titleDraft := ""
    assignErr := ""
    renameErr := ""
    closeErr := ""
    postErr := ""
    labelErr := ""
  }

  action assignIt(id: number, user: string, fromRow: boolean) {
    if (fromRow) { onFlush(() => { rowErr := "" }) } else { onFlush(() => { assignErr := "" }) }
    guess assigning := as => [...as, { id: id, assignee: user }]
    try {
      let r = await assign(id, user)
      assignedOk := as => [...as, { id: r.id, assignee: r.assignee }]
    } catch (e) {
      if (fromRow) { rowErr := e.message } else { assignErr := e.message }
    }
  }

  action renameIt(id: number, t: string) {
    onFlush(() => { renameErr := "" })
    guess renaming := rs => [...rs, { id: id, title: t }]
    try {
      let r = await renameIssue(id, t)
      renamedOk := rs => [...rs, { id: r.id, title: r.title }]
    } catch (e) {
      renameErr := e.message
    }
  }

  action closeIt(id: number, fromRow: boolean) {
    if (fromRow) { onFlush(() => { rowErr := "" }) } else { onFlush(() => { closeErr := "" }) }
    guess closing := cs => [...cs, id]
    try {
      await closeIssue(id)
      closedOk := cs => [...cs, id]
    } catch (e) {
      if (fromRow) { rowErr := e.message } else { closeErr := e.message }
    }
  }

  action postIt(id: number, author: string, t: string) {
    onFlush(() => { postErr := "" })
    guess sendingC := cs => [...cs, { id: id, author: author, text: t }]
    try {
      await addComment(id, author, t)
      refresh commentsQ
    } catch (e) {
      postErr := e.message
    }
  }

  action addLabelIt(id: number, label: string) {
    onFlush(() => { labelErr := "" })
    guess addingL := xs => [...xs, { id: id, label: label }]
    try {
      await addLabel(id, label)
      refresh labelsQ
    } catch (e) {
      labelErr := e.message
    }
  }

  action removeLabelIt(id: number, label: string) {
    onFlush(() => { labelErr := "" })
    guess removingL := xs => [...xs, { id: id, label: label }]
    try {
      await removeLabel(id, label)
      refresh labelsQ
    } catch (e) {
      labelErr := e.message
    }
  }

  <section>
    <p>
      <input data-testid="user" value={who} onInput={(e) => { who := e.target.value }} />
    </p>
    <div>
      <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
      <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
    </div>
    <div data-testid="list">
      {loading on(filter) fallback { <p>loading {filter} issues</p> } {
        {errored fallback(e) { <p>list error: {e.message}</p> } {
          <NoteOpen ids={issues.map(i => i.id)} open={filter == "open"} />
          <ul>
            {for it in shownRows {
              <li>
                <span data-testid="issue" onClick={() => { pickIssue(it.id) }}>#{it.id} {it.title} ({it.assignee == null ? "unassigned" : it.assignee})</span>
                <button data-testid="row-assign" onClick={() => { assignIt(it.id, who, true) }}>assign to {who}</button>
                {if filter == "open" {
                  <button data-testid="row-close" onClick={() => { closeIt(it.id, true) }}>close</button>
                }}
              </li>
            }}
          </ul>
        }}
      }}
    </div>
    {if rowErr != "" { <p data-testid="row-error">row error: {rowErr}</p> }}

    <section data-testid="detail">
      {if sel == 0 {
        <p>select an issue</p>
      } else {
        <div>
          {loading on(sel) fallback { <p>loading #{sel}</p> } {
            {errored fallback(e) { <p>detail error: {e.message}</p> } {
              {if detailQ == null {
                <p>detail error: issue #{sel} not found</p>
              } else {
                <div>
                  <h2>#{sel} {shownTitle}</h2>
                  <p>{detailQ.body}</p>
                  <RelatedHelp title={detailQ.title} />
                </div>
              }}
            }}
          }}
          <button data-testid="retry" onClick={() => { refresh detailQ }}>retry</button>

          <div>
            <input data-testid="title-input" value={titleDraft} onInput={(e) => { titleDraft := e.target.value }} />
            <button data-testid="rename" onClick={() => { if (titleDraft != "") { renameIt(sel, titleDraft) } }}>rename</button>
            {if renameErr != "" { <p>rename error: {renameErr}</p> }}
          </div>

          <div>
            <button data-testid="assign" onClick={() => { assignIt(sel, who, false) }}>assign to {who}</button>
            {if assignErr != "" { <p>assign error: {assignErr}</p> }}
            <button data-testid="close" onClick={() => { closeIt(sel, false) }}>close</button>
            {if closeErr != "" { <p>close error: {closeErr}</p> }}
          </div>

          <section data-testid="comments">
            {loading on(sel) fallback { <p>loading comments</p> } {
              {errored fallback(e) { <p>comments error: {e.message}</p> } {
                <ul>
                  {for c in commentsQ {
                    <li data-testid="comment">{c.author}: {c.text}</li>
                  }}
                  {for s in sendingRows {
                    <li data-testid="comment">{s.author}: {s.text} (sending…)</li>
                  }}
                </ul>
              }}
            }}
          </section>
          <div>
            <input data-testid="comment-input" value={commentDraft} onInput={(e) => { commentDraft := e.target.value }} />
            <button data-testid="post" onClick={() => {
              if (commentDraft != "") {
                let t = commentDraft
                onFlush(() => { commentDraft := "" })
                postIt(sel, who, t)
              }
            }}>post</button>
            {if postErr != "" { <p>post error: {postErr}</p> }}
          </div>

          <section data-testid="labels">
            {loading on(sel) fallback { <p>loading labels</p> } {
              {errored fallback(e) { <p>labels error: {e.message}</p> } {
                <div>
                  <ul>
                    {for l in labelsShown {
                      <li>
                        <span data-testid="label">{l}</span>
                        <button data-testid="remove-label" onClick={() => { removeLabelIt(sel, l) }}>remove {l}</button>
                      </li>
                    }}
                  </ul>
                  <input data-testid="label-input" value={labelDraft} onInput={(e) => { labelDraft := e.target.value }} />
                  <button data-testid="add-label" onClick={() => {
                    let l = labelDraft.trim()
                    if (l != "" && !labelsShown.some(x => x == l)) {
                      onFlush(() => { labelDraft := "" })
                      addLabelIt(sel, l)
                    }
                  }}>add label</button>
                  {if labelErr != "" { <p>label error: {labelErr}</p> }}
                </div>
              }}
            }}
          </section>
        </div>
      }}
    </section>
  </section>
}

component HelpPage() {
  source query: string := peek(handoffQ)
  source picked: number := peek(handoffId)
  hits = query.length < 2 ? [] : await search(query)
  itemQ = picked == 0 ? null : await fetchItem(picked)
  searching = pending? hits

  <section>
    <input data-testid="query" value={query} onInput={(e) => { let v = e.target.value; onFlush(() => { query := v }) }} />
    <div data-testid="results">
      {if query.length == 1 {
        <p>too short: {query}</p>
      } else {
        {loading fallback { <p>searching…</p> } {
          {errored fallback(e) { <p>search failed: {e.message}</p> } {
            <div>
              {if searching { <p>searching…</p> }}
              {if query.length >= 2 && !searching { <p>{hits.length} results for {query}</p> }}
              <ul>
                {for h in hits {
                  <li data-testid="hit" onClick={() => { picked := h.id }}>{h.id == picked ? "> " : ""}{h.name}</li>
                }}
              </ul>
            </div>
          }}
        }}
      }}
    </div>
    <div data-testid="item">
      {if picked == 0 {
        <p>pick a result</p>
      } else {
        {loading on(picked) fallback { <p>loading…</p> } {
          {errored fallback(e) {
            <div>
              <p>failed: {e.message}</p>
              <button data-testid="retry-item" onClick={() => { refresh itemQ }}>retry</button>
            </div>
          } {
            {if itemQ == null {
              <p>item {picked} not found</p>
            } else {
              <div>
                <h3>{itemQ.name}</h3>
                <p>{itemQ.blurb}</p>
              </div>
            }}
          }}
        }}
      }}
    </div>
  </section>
}

component SettingsForm(props: { initial: Settings; onSave: (s: Settings) => void }) {
  source name: string := peek(props.initial.name)
  source theme: string := peek(props.initial.theme)
  source density: string := peek(props.initial.density)
  nameInvalid = name.length == 0 || name.length > 20
  nameError = name.length == 0 ? "Display name is required" : `Display name must be at most 20 characters, not ${name.length}`

  <div>
    <input data-testid="name" value={name} onInput={(e) => { name := e.target.value }} />
    <span data-testid="name-count">{name.length}/20</span>
    {if nameInvalid { <p data-testid="name-error">{nameError}</p> }}
    <button data-testid="theme-light" onClick={() => { theme := "light" }}>light</button>
    <button data-testid="theme-dark" onClick={() => { theme := "dark" }}>dark</button>
    <button data-testid="density-toggle" onClick={() => { density := density == "compact" ? "comfortable" : "compact" }}>density</button>
    <p data-testid="preview">Preview: {theme} / {density}</p>
    <button data-testid="save" onClick={() => {
      if (!nameInvalid) { props.onSave({ name: name, theme: theme, density: density }) }
    }}>save</button>
  </div>
}

component SettingsPage() {
  source savedS: Settings = await loadSettings()
  source saveErr: string := ""
  savingNow = pending? savedS

  action saveIt(s: Settings) {
    onFlush(() => { saveErr := "" })
    guess savedS := s
    affects savedS
    try {
      let answer = await saveSettings(s)
      savedS := answer
    } catch (e) {
      saveErr := `Save failed: ${e.message}`
    }
  }

  <section>
    {loading fallback { <p data-testid="load">Loading settings…</p> } {
      {errored fallback(e) {
        <div data-testid="load">
          <p>Could not load settings: {e.message}</p>
          <button data-testid="retry-load" onClick={() => { refresh savedS }}>retry</button>
        </div>
      } {
        <div>
          <p data-testid="saved">Saved: {savedS.name} · {savedS.theme} · {savedS.density}{savingNow ? " (saving…)" : ""}</p>
          <SettingsForm initial={savedS} onSave={(s) => { saveIt(s) }} />
          {if saveErr != "" { <p data-testid="save-error">{saveErr}</p> }}
        </div>
      }}
    }}
  </section>
}

export default component App() {
  <main>
    <nav>
      <button data-testid="tab-issues" onClick={() => { page := "issues" }}>{issuesLabel}</button>
      <button data-testid="tab-help" onClick={() => { handoffQ := ""; handoffId := 0; page := "help" }}>help</button>
      <button data-testid="tab-settings" onClick={() => { page := "settings" }}>settings</button>
    </nav>
    {if page == "issues" {
      <IssuesPage />
    } else if page == "help" {
      <HelpPage />
    } else {
      <SettingsPage />
    }}
  </main>
}
