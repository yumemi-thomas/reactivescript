// The board page, in the shape of Solid's own board example: one optimistic store over the server's board.
//
// The server answers per column, so its board is three questions. The store, `board`, is those answers laid flat:
// one row per card, naming its column and its place, keyed by id. The columns on screen are derived from it by
// filtering and sorting, so moving a card is one field write on one row, and a card shows in exactly one column.
//
// Every write has the same life. Its guess is a path write into `board` (or into the checklist, the other store),
// shown at once. The write goes to the server; when it is accepted, the action re-asks the answers it changed, and
// holds until they land (D-34), so the guess is dropped onto data that already agrees with it. When it is declined
// there was only ever the guess, and removing it is the undo. Errors are plain client state under the guesses: a
// refusal is a fact about one request, and no answer has a place for it.
//
// An add has no id until the server answers. Its placeholder is guessed into the store under a key minted here, for
// this visit only, and is inert (no move buttons, not selectable). The server's answer is the new card itself, so the
// action records it in To do's answer (a write whose answer is the new value re-asks nothing) and ends: in one frame
// the placeholder goes with its guess and the real card shows from the truth. An added item is the same over the
// checklist's answer.
//
// Everything here is the visit's: the page is mounted only while it is open, so leaving it discards the store, its
// guesses and its errors, and opening it again asks the server again.

import pure { fetchCards, fetchChecklist } from "./api"
import { moveCard, renameCard, addCard, archiveCard, toggleItem, addItem, Card, Item } from "./api"

export type Row = { id: number; title: string; done: number; total: number; col: string; pos: number; adding: boolean; gone: boolean }
type Line = { id: number; text: string; done: boolean; adding: boolean }

fn colName(c: string): string => c == "todo" ? "To do" : c == "doing" ? "Doing" : "Done"
fn rowsOf(cs: Card[] | null, col: string): Row[] =>
  cs == null ? [] : cs.map((c, i) => ({ id: c.id, title: c.title, done: c.done, total: c.total, col: col, pos: i, adding: false, gone: false }))
type List = { card: number; items: Item[] }
fn withCard(cs: Card[] | null, c: Card): Card[] | null => cs == null || cs.some(x => x.id == c.id) ? cs : [...cs, c]
fn counted(cs: Card[] | null, id: number): Card[] | null => cs == null ? cs : cs.map(c => c.id == id ? { ...c, total: c.total + 1 } : c)
fn withItem(l: List | null, card: number, it: Item): List | null =>
  l == null || l.card != card || l.items.some(x => x.id == it.id) ? l : { card: card, items: [...l.items, it] }
fn has(cs: Card[] | null, id: number): boolean => cs != null && cs.some(c => c.id == id)
fn inCol(b: Row[], col: string): Row[] => b.filter(r => r.col == col && !r.gone).sort((x, y) => x.pos - y.pos)
// the place between the rows at i-1 and i (the column without the card being moved), as the example's keyAt
fn placeAt(rows: Row[], i: number): number =>
  rows.length == 0 ? 0 : i <= 0 ? rows[0].pos - 1 : i >= rows.length ? rows[rows.length - 1].pos + 1 : (rows[i - 1].pos + rows[i].pos) / 2

// Where a move puts a card, worked out from the board as shown: `col` set, to the bottom of that column; `col` empty,
// `by` places up or down in its own.
type Place = { col: string; index: number; pos: number }
fn placeOf(b: Row[], id: number, col: string, by: number): Place =>
  col != "" ? ({ col: col, index: inCol(b, col).length, pos: placeAt(inCol(b, col), inCol(b, col).length) }) : stepped(b, id, b.find(r => r.id == id)?.col ?? "todo", by)
fn stepped(b: Row[], id: number, col: string, by: number): Place =>
  ({ col: col, index: inCol(b, col).findIndex(r => r.id == id) + by,
     pos: placeAt(inCol(b, col).filter(r => r.id != id), inCol(b, col).findIndex(r => r.id == id) + by) })

component Column(props: {
  col: string; ans: Card[] | null; rows: Row[]; retrying: boolean; left: string; right: string;
  leftOpen: boolean; rightOpen: boolean; onRetry: () => void; onSelect: (id: number) => void; onMove: (id: number, col: string, by: number) => void;
}) {
  <section data-testid={`col-${props.col}`} style="min-width: 14rem">
    {errored fallback(e) {
      <h2 data-testid={`head-${props.col}`}>{colName(props.col)}</h2>
      {if props.retrying {
        <p>loading</p>
      } else {
        <p>error: {e.message}{" "}<button data-testid={`retry-${props.col}`} onClick={() => { props.onRetry() }}>retry</button></p>
      }}
    } {
      {if props.ans == null {
        <h2 data-testid={`head-${props.col}`}>{colName(props.col)}</h2>
        <p>loading</p>
      } else {
        <h2 data-testid={`head-${props.col}`}>{colName(props.col)} ({props.rows.length})</h2>
        <ul>
          {for r in props.rows {
            <li>
              {if r.adding {
                <span data-testid="card">{r.title} (adding…)</span>
              } else {
                <button data-testid="card" onClick={() => { props.onSelect(r.id) }}>#{r.id} {r.title} · {r.done}/{r.total}</button>
                {if props.left != "" {
                  {" "}<button data-testid="left" disabled={!props.leftOpen} onClick={() => { props.onMove(r.id, props.left, 0) }}>left</button>
                }}
                {if props.right != "" {
                  {" "}<button data-testid="right" disabled={!props.rightOpen} onClick={() => { props.onMove(r.id, props.right, 0) }}>right</button>
                }}
                {if props.rows[0].id != r.id {
                  {" "}<button data-testid="up" onClick={() => { props.onMove(r.id, "", -1) }}>up</button>
                }}
                {if props.rows[props.rows.length - 1].id != r.id {
                  {" "}<button data-testid="down" onClick={() => { props.onMove(r.id, "", 1) }}>down</button>
                }}
              }}
            </li>
          }}
        </ul>
      }}
    }}
  </section>
}

export component BoardPage() {
  // 1. The server's truth: one question per column, `null` until its first answer, so one column loading or failing
  // never holds another.
  // Sources with a question: an accepted add writes its answer here, until the next re-ask brings the server's list.
  source todoAns = await fetchCards("todo") -> null
  source doingAns = await fetchCards("doing") -> null
  source doneAns = await fetchCards("done") -> null

  // 2. The one store over it, flat; every guess is a path write into it.
  board key id = [...rowsOf(todoSeen, "todo"), ...rowsOf(doingSeen, "doing"), ...rowsOf(doneSeen, "done")]
  todo = inCol(board, "todo")
  doing = inCol(board, "doing")
  done = inCol(board, "done")
  // each answer as the other panes read it: `null` while it loads or after it failed
  todoSeen = todoAns catch (e) => null
  doingSeen = doingAns catch (e) => null
  doneSeen = doneAns catch (e) => null
  todoUp = todoSeen != null
  doingUp = doingSeen != null
  doneUp = doneSeen != null
  // the work-in-progress limit counts the cards Doing shows, moves still out included
  intoDoing = doingUp && doing.length < 3
  // the column whose answer holds a card: what a write to it changes on the server, whatever the guesses show
  fn home(id: number): string => has(todoSeen, id) ? "todo" : has(doingSeen, id) ? "doing" : "done"

  // The selection and its checklist, the other store.
  source selected: number | null := null
  // the answer names its card, so an item add answered after another card was selected leaves it alone
  source listAns = selected == null ? null : { card: selected, items: await fetchChecklist(selected) }
  checklist key id = listAns == null ? [] : listAns.items.map(it => ({ id: it.id, text: it.text, done: it.done, adding: false }))
  sel = selected == null ? null : board.find(r => r.id == selected && !r.gone && !r.adding) ?? null

  // Inputs, and what went wrong: plain client state of this visit.
  source newCard: string := ""
  source titleInput: string := ""
  source itemInput: string := ""
  source minted: number := 0
  source moveError: string := ""
  source addError: string := ""
  source archiveError: string := ""
  source renameError: string := ""
  source itemError: string := ""

  // selecting starts the detail as it starts: its inputs empty, its errors gone
  action pick(id: number) {
    selected := id
    titleInput := ""
    itemInput := ""
    renameError := ""
    itemError := ""
  }

  // An accepted card write ends by re-asking the answers it changed: for a move the one that held the card and the
  // one it joined, for an edit the one that holds it.
  action reask(a: string, b: string) {
    if (a == "todo" || b == "todo") { refresh todoAns }
    if (a == "doing" || b == "doing") { refresh doingAns }
    if (a == "done" || b == "done") { refresh doneAns }
  }

  action retry(col: string) {
    if (col == "todo") {
      affects todoAns
      refresh todoAns
    } else if (col == "doing") {
      affects doingAns
      refresh doingAns
    } else {
      affects doneAns
      refresh doneAns
    }
  }

  // The place is worked out by the click, from the board as shown, as the example's `nudge` does: an action that read
  // another action's guess and guessed beside it would be one change with it (D-33).
  action move(id: number, from: string, col: string, index: number, pos: number) {
    try {
      let i = board.findIndex(r => r.id == id)
      guess board[i].col := col
      guess board[i].pos := pos
      onFlush(() => { moveError := "" })
      await moveCard(id, col, index)
      await reask(from, col)
    } catch (e) {
      moveError := e.message
      onFlush(() => { moveError := e.message })
    }
  }

  action add(key: number, title: string, at: number, pos: number) {
    try {
      guess board[at] := { id: key, title: title, done: 0, total: 0, col: "todo", pos: pos, adding: true, gone: false }
      onFlush(() => { addError := "" })
      let r = await addCard("todo", title)
      todoAns := cs => withCard(cs, { id: r.id, title: r.title, done: 0, total: 0 })
    } catch (e) {
      addError := e.message
      onFlush(() => { addError := e.message })
    }
  }

  action rename(id: number, title: string, col: string) {
    let i = board.findIndex(r => r.id == id)
    try {
      guess board[i].title := title
      onFlush(() => { renameError := "" })
      await renameCard(id, title)
      await reask(col, col)
    } catch (e) {
      renameError := e.message
      onFlush(() => { renameError := e.message })
    }
  }

  action archive(id: number, col: string) {
    let i = board.findIndex(r => r.id == id)
    try {
      guess board[i].gone := true
      onFlush(() => {
        selected := null
        archiveError := ""
      })
      await archiveCard(id)
      await reask(col, col)
    } catch (e) {
      archiveError := e.message
      onFlush(() => { archiveError := e.message })
    }
  }

  action toggle(card: number, item: number, to: boolean, col: string) {
    try {
      let i = board.findIndex(r => r.id == card)
      let j = checklist.findIndex(it => it.id == item)
      guess checklist[j].done := to
      guess board[i].done := n => n + (to ? 1 : -1)
      onFlush(() => { itemError := "" })
      await toggleItem(card, item, to)
      refresh listAns
      await reask(col, col)
    } catch (e) {
      itemError := e.message
      onFlush(() => { itemError := e.message })
    }
  }

  action addLine(card: number, key: number, text: string) {
    let i = board.findIndex(r => r.id == card)
    try {
      guess checklist := ls => [...ls, { id: key, text: text, done: false, adding: true }]
      guess board[i].total := n => n + 1
      onFlush(() => { itemError := "" })
      let it = await addItem(card, text)
      listAns := l => withItem(l, card, it)
      todoAns := cs => counted(cs, card)
      doingAns := cs => counted(cs, card)
      doneAns := cs => counted(cs, card)
    } catch (e) {
      itemError := e.message
      onFlush(() => { itemError := e.message })
    }
  }

  <div>
    <div style="display: flex; gap: 1.5rem; align-items: flex-start">
      <div>
        <Column col="todo" ans={todoAns} rows={todo} retrying={pending? todoAns} left="" right="doing" leftOpen={false} rightOpen={intoDoing}
          onRetry={() => { retry("todo") }} onSelect={id => { pick(id) }} onMove={(id, c, by) => { let p = placeOf(board, id, c, by); move(id, home(id), p.col, p.index, p.pos) }} />
        <div>
          <input data-testid="new-card" value={newCard} onInput={e => { newCard := e.target.value }} placeholder="new card" />{" "}
          <button data-testid="add-card" disabled={!todoUp} onClick={() => {
            if (newCard != "") {
              let t = newCard
              let key = -(minted + 1)
              onFlush(() => {
                newCard := ""
                minted := n => n + 1
              })
              add(key, t, board.length, placeAt(todo, todo.length))
            }
          }}>add</button>
          {if addError != "" {
            <p data-testid="add-error">add error: {addError}</p>
          }}
        </div>
      </div>
      <Column col="doing" ans={doingAns} rows={doing} retrying={pending? doingAns} left="todo" right="done" leftOpen={todoUp} rightOpen={doneUp}
        onRetry={() => { retry("doing") }} onSelect={id => { pick(id) }} onMove={(id, c, by) => { let p = placeOf(board, id, c, by); move(id, home(id), p.col, p.index, p.pos) }} />
      <Column col="done" ans={doneAns} rows={done} retrying={pending? doneAns} left="doing" right="" leftOpen={intoDoing} rightOpen={false}
        onRetry={() => { retry("done") }} onSelect={id => { pick(id) }} onMove={(id, c, by) => { let p = placeOf(board, id, c, by); move(id, home(id), p.col, p.index, p.pos) }} />
      <section data-testid="detail" style="min-width: 16rem">
        {if sel == null {
          <p>select a card</p>
        } else {
          <h2>#{sel.id} {sel.title}</h2>
          <p>in {colName(sel.col)}</p>
          <div>
            <input data-testid="title-input" value={titleInput} onInput={e => { titleInput := e.target.value }} placeholder="new title" />{" "}
            <button data-testid="rename" onClick={() => {
              if (titleInput != "") {
                let t = titleInput
                onFlush(() => { titleInput := "" })
                rename(sel.id, t, home(sel.id))
              }
            }}>rename</button>{" "}
            <button data-testid="archive" onClick={() => { archive(sel.id, home(sel.id)) }}>archive</button>
          </div>
          {if renameError != "" {
            <p>rename error: {renameError}</p>
          }}
          <div data-testid="checklist">
            {loading on(selected) fallback { <p>loading checklist</p> } {
              {errored fallback(e) { <p>checklist error: {e.message}</p> } {
                <ul>
                  {for it in checklist {
                    <li>
                      {if it.adding {
                        <span data-testid="item">[ ] {it.text} (adding…)</span>
                      } else {
                        <span data-testid="item">[{it.done ? "x" : " "}] {it.text}</span>{" "}
                        <button data-testid="toggle" disabled={pending? checklist} onClick={() => { toggle(sel.id, it.id, !it.done, home(sel.id)) }}>toggle</button>
                      }}
                    </li>
                  }}
                </ul>
                <p data-testid="progress">{checklist.filter(it => it.done).length}/{checklist.length} done</p>
                <input data-testid="item-input" value={itemInput} onInput={e => { itemInput := e.target.value }} placeholder="new item" />{" "}
                <button data-testid="add-item" disabled={pending? checklist} onClick={() => {
                  if (itemInput != "") {
                    let t = itemInput
                    let key = -(minted + 1)
                    onFlush(() => {
                      itemInput := ""
                      minted := n => n + 1
                    })
                    addLine(sel.id, key, t)
                  }
                }}>add item</button>
              }}
            }}
          </div>
          {if itemError != "" {
            <p>item error: {itemError}</p>
          }}
        }}
      </section>
    </div>
    <pre>STORE[{board.map(r => `${r.id}:${r.col}:${r.pos}:${r.gone}`).join(" ")}] DOING[{doingSeen == null ? "null" : doingSeen.map(c => `${c.id}`).join(" ")}] DONE[{doneSeen == null ? "null" : doneSeen.map(c => `${c.id}`).join(" ")}]</pre>
    {if moveError != "" {
      <p data-testid="move-error">move error: {moveError}</p>
    }}
    {if archiveError != "" {
      <p data-testid="archive-error">archive error: {archiveError}</p>
    }}
  </div>
}
