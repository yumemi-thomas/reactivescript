// solid-use/provider: the library's own injection (theme.js provides a value and reads it); it is no
// context, so its reader with no scope above fails when it runs, not when it is checked.
import { ThemeScope, useTheme } from "./theme.js"

component Badge() {
  theme = useTheme()
  <b class={theme}>{theme}</b>
}
export default component App() {
  <ThemeScope value="dark"><Badge /></ThemeScope>
}
