// rx-declare's draft of the module, as it is: the components that render each kind of node are given by name, in a
// record, and each is checked as applied beneath <Markdown> (09 MO-11c).
export component Markdown(props: import("solid-marked/component").MarkdownProps & { builtins: { Blockquote?: Component; Code?: Component; Definition?: Component; Delete?: Component; Emphasis?: Component; FootnoteDefinition?: Component; FootnoteReference?: Component; HTML?: Component; Heading?: Component; Image?: Component; ImageReference?: Component; InlineCode?: Component; Link?: Component; LinkReference?: Component; List?: Component; ListItem?: Component; Paragraph?: Component; Root?: Component; Strong?: Component; Table?: Component; TableCell?: Component; TableRow?: Component }; components?: Record<string, Component> })
