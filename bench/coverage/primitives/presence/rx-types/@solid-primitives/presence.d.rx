//@ for @solid-primitives/presence ^1.0.0
export type Options = import("@solid-primitives/presence").Options
export fn createPresence<TItem>(ref item: TItem | undefined, options: Options): { isMounted: () => boolean; mountedItem: ref TItem | undefined; isVisible: () => boolean; isAnimating: () => boolean; isEntering: () => boolean; isExiting: () => boolean; done: (event?: Event) => void; bindDone: () => (event?: Event) => void }
