// The library's `createUndoHistory(source)` takes one function that reads the state (tracked) and answers the function
// that sets it back: two callbacks of two kinds in one. history.js gives it a value to follow and a setter.
export pure fn createUndoHistory<T>(ref value: T, restore: handler (value: T) => void): { canUndo: () => boolean; canRedo: () => boolean; undo: () => void; redo: () => void }
