// @solid-primitives/sortable: a list kept sorted by a comparator — through sorted.js, a module of the app's own: the
// library's createSorted sorts the list it is given in place under `{ dirty: true }`, so its row is not `pure`.
import { by } from "@solid-primitives/sortable"
import { sortedBy } from "./sorted.js"

export default component App() {
  source people := [{ name: "Grace", born: 1906 }, { name: "Ada", born: 1815 }]
  sorted = sortedBy(people, by((p: { name: string, born: number }) => p.born))
  <ol>{for p in sorted { <li>{p.name}</li> }}</ol>
  <button onClick={() => { people := ps => [...ps, { name: "Alan", born: 1912 }] }}>add</button>
}
