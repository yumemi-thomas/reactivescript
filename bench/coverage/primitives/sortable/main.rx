// @solid-primitives/sortable: a list kept sorted by a comparator.
import { createSorted, by } from "@solid-primitives/sortable"

export default component App() {
  source people := [{ name: "Grace", born: 1906 }, { name: "Ada", born: 1815 }]
  sorted = createSorted(people, by((p: { name: string, born: number }) => p.born))
  <ol>{for p in sorted { <li>{p.name}</li> }}</ol>
  <button onClick={() => { people := ps => [...ps, { name: "Alan", born: 1912 }] }}>add</button>
}
