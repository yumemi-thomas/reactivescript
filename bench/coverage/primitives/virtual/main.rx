// @solid-primitives/virtual: a long list of which only the rows in view are rendered.
import { VirtualList } from "@solid-primitives/virtual"

export default component App() {
  source rows := ["row 0", "row 1", "row 2", "row 3", "row 4", "row 5", "row 6", "row 7", "row 8", "row 9", "row 10", "row 11", "row 12", "row 13", "row 14", "row 15", "row 16", "row 17", "row 18", "row 19"]
  <VirtualList each={rows} rootHeight={60} rowHeight={20} overscanCount={1}>
    {view (row, index) { <div class="row" style="height:20px">{row()}</div> }}
  </VirtualList>
}
