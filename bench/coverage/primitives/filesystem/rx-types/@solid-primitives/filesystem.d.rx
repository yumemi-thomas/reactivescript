//@ for @solid-primitives/filesystem ^3.0.0
export type ItemType = import("@solid-primitives/filesystem").ItemType
export type DirEntries = import("@solid-primitives/filesystem").DirEntries
export type Watcher = import("@solid-primitives/filesystem").Watcher
export type ObjectFileSystem = import("@solid-primitives/filesystem").ObjectFileSystem
export fn createFileSystem(fs: { async: false; getType: (path: string) => ItemType; mkdir: (path: string) => void; readdir: (path: string) => DirEntries; readFile: (path: string) => string; rename?: (previous: string, next: string) => void; rm: (path: string) => void; writeFile: (path: string, data: string) => void }, watcher?: (...args: Parameters<NonNullable<Watcher>>) => void): { getType: (path: string, refresh?: true) => ItemType | undefined; mkdir: (path: string) => void; readdir: (path: string, refresh?: true) => DirEntries | undefined; readFile: (path: string, refresh?: true) => string | undefined; rename: (previous: string, next: string) => void; rm: (path: string) => void; writeFile: (path: string, data: string) => void } instantiates
// (`storage` is left out: the call writes to the one it is given)
export pure fn makeVirtualFileSystem(initial?: ObjectFileSystem): { async: false; getType: (path: string) => ItemType; mkdir: (path: string) => void; readdir: (path: string) => DirEntries; readFile: (path: string) => string; rename?: (previous: string, next: string) => void; rm: (path: string) => void; writeFile: (path: string, data: string) => void }
