// @solid-primitives/async: an abort signal for work an action starts, aborted from a handler.
import { createAbortable } from "@solid-primitives/async"

export default component App() {
  source state := "idle"
  [signal, abort] = createAbortable()
  <p>{state}</p>
  <button class="start" onClick={() => { state := signal.aborted ? "aborted" : "running" }}>start</button>
  <button class="stop" onClick={() => { abort(); state := "stopped" }}>stop</button>
}
