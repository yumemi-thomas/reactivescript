//@ for @solid-primitives/event-listener ^3.0.0
export type TargetWithEventMap = import("@solid-primitives/event-listener").TargetWithEventMap
export type EventMapOf<Target> = import("@solid-primitives/event-listener").EventMapOf<Target>
export type EventListenerOptions = import("@solid-primitives/event-listener").EventListenerOptions
