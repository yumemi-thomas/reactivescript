export pure fn createEventListener<Target extends TargetWithEventMap, EventMap extends EventMapOf<Target>, EventType extends keyof EventMap>(ref target: import("@solid-primitives/utils").Many<Target | undefined>, ref type_: import("@solid-primitives/utils").Many<EventType>, handler: handler (event: EventMap[EventType]) => void, options?: EventListenerOptions): void
