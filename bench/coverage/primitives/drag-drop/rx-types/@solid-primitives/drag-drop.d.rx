//@ for @solid-primitives/drag-drop ^0.1.0
export type DragRect = import("@solid-primitives/drag-drop").DragRect
export type DroppableRect = import("@solid-primitives/drag-drop").DroppableRect
export type Point = import("@solid-primitives/drag-drop").Point
export type DragItem<T = unknown> = import("@solid-primitives/drag-drop").DragItem<T>
export type Transform = import("@solid-primitives/drag-drop").Transform
export type DroppableItem<T = unknown> = import("@solid-primitives/drag-drop").DroppableItem<T>
export type CreateDraggableOptions = import("@solid-primitives/drag-drop").CreateDraggableOptions
// export pure fn createDragContext(options?: { collisionDetection?: (draggable: DragRect, droppables: DroppableRect[], pointer: Point) => string | number | null; onDragStart?: (item: DragItem) => void; onDragMove?: (item: DragItem, transform: Transform) => void; onDragEnd?: (item: DragItem, over: DroppableItem | null) => void; onDragCancel?: (item: DragItem) => void; keyboardStep?: number; autoScroll?: boolean | { threshold?: number | undefined; speed?: number | undefined; } | undefined }): { Provider: (props: { children: import("solid-js").Element }) => View; active: ref DragItem | null; over: ref DroppableItem | null; transform: ref Transform | null }
export fn createDraggable<T = unknown>(id: string | number, data?: T, options?: CreateDraggableOptions): { ref: (el: HTMLElement) => void; isDragging: () => boolean; transform: ref Transform | null; id: string | number }
