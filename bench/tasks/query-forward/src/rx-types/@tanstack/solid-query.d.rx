//@ for @tanstack/solid-query ^6.0.0-rc.6
// @tanstack/solid-query 6 (Solid 2.0) in rows: the client's context, its provider, and a query whose `data` waits and
// throws where it is read (MO-10f). The types are the package's own.
export context queryClient
export component QueryClientProvider(props: { client: any; children?: View }) provides(queryClient)
export pure fn useQuery(ref options: { queryKey: any[]; queryFn: tracked () => Promise<any> }): { data: pending fails(Error) any; isFetching: boolean; status: string } uses(queryClient)
