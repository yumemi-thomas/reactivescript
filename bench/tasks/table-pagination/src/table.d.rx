// The table adapter in rows. A table is given cell components and the view calls flexRender on them; the row says
// nothing of where (09 MO-8r), so each cell is checked under a root of its own (MO-11s) and the table is a plain value.
export type CellContext<TData extends import("@tanstack/table-core").RowData, TValue> = import("./table.js").CellContext<TData, TValue>
export type Table<TData extends import("@tanstack/table-core").RowData> = import("./table.js").Table<TData>
export pure fn getCoreRowModel<TData extends import("@tanstack/table-core").RowData>(): ((table: Table<TData>) => () => import("@tanstack/table-core").RowModel<TData>)
export pure fn getPaginationRowModel<TData extends import("@tanstack/table-core").RowData>(opts?: { initialSync: boolean; }): ((table: Table<TData>) => () => import("@tanstack/table-core").RowModel<TData>)
// The result's type is what the app reads of the table. `instantiates`: the table keeps state of its own (its page), so
// it is made once where it is bound, whatever its parameter is.
export pure fn createTable<T>(ref options: Omit<import("@tanstack/table-core").TableOptions<T>, "state" | "onStateChange" | "renderFallbackValue">): { getHeaderGroups: () => import("@tanstack/table-core").HeaderGroup<T>[]; getRowModel: () => { rows: { id: string; getVisibleCells: () => import("@tanstack/table-core").Cell<T, unknown>[] }[] }; getState: () => { pagination: { pageIndex: number; pageSize: number } }; getPageCount: () => number; getCanNextPage: () => boolean; getCanPreviousPage: () => boolean; nextPage: () => void; previousPage: () => void; setPageIndex: (index: number) => void } instantiates
export pure fn flexRender<P>(comp: Parameters<typeof import("./table.js").flexRender>[0], props: P): View
