// The adapter in rows, as rx-declare drafts it: the options' callbacks, and a result whose parts are accessors and one
// function that answers nothing (MO-10b). By hand: `pure` (the virtualizer is made once, and writes only its own state).
export pure fn createVirtualizer(ref options: { count: number; getScrollElement: () => Element | null | undefined; estimateSize: (index: number) => number }): { items: ref import("@tanstack/virtual-core").VirtualItem[]; totalSize: ref number; scrollToIndex: (index: number) => void }
