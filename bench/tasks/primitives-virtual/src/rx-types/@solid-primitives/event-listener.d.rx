//@ for @solid-primitives/event-listener ^3.0.0
// As rx-declare drafts them: makeEventListener answers the library's `VoidFunction`, drafted as what it is, `() => void`,
// so the checker holds a call to keeping it (EF-5a); `Many<T>` is the library's own dependency's type, named as the
// library resolves it (wherever the install put @solid-primitives/utils, MO-8o). By hand: the listener is called later (`handler`), and
// createEventListener is a primitive made once where it is written (`pure … instantiates`).
export type TargetWithEventMap = import("@solid-primitives/event-listener").TargetWithEventMap
export type EventMapOf<Target> = import("@solid-primitives/event-listener").EventMapOf<Target>
export type EventListenerOptions = import("@solid-primitives/event-listener").EventListenerOptions
export fn createEventListener<Target extends TargetWithEventMap, EventMap extends EventMapOf<Target>, EventType extends keyof EventMap>(ref target: import("@solid-primitives/utils").Many<Target | undefined>, ref type_: import("@solid-primitives/utils").Many<EventType>, handler: handler (event: EventMap[EventType]) => void, options?: EventListenerOptions): void
export fn makeEventListener<Target extends TargetWithEventMap, EventMap extends EventMapOf<Target>, EventType extends keyof EventMap>(target: Target, type_: EventType, handler: handler (event: EventMap[EventType]) => void, options?: EventListenerOptions): () => void
