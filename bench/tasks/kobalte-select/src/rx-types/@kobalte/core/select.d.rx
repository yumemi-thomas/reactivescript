//@ for @kobalte/core ^2.0.0-alpha.4
// Kobalte's Select in rows, as `rx-declare --run --dom @kobalte/core/select` drafts it, kept to the parts the app uses. By hand: the
// root's `onChange` is called later (`handler`), and the type of the props an item component is given.
export type SelectRootItemComponentProps<T> = import("@kobalte/core/select").SelectRootItemComponentProps<T>
export context select   // drafted by running: hooks that throw with no provider read it
export component Select(props: { value?: any; defaultValue?: any; onChange?: handler (...args: any[]) => any; multiple?: boolean | undefined; id?: string | undefined; forceMount?: boolean | undefined; disabled?: boolean | undefined; name?: string | undefined; options: any; required?: boolean | undefined; getAnchorRect?: (...args: any[]) => any; placement?: any; gutter?: number | undefined; shift?: number | undefined; flip?: string | boolean | undefined; slide?: boolean | undefined; overlap?: boolean | undefined; sameWidth?: boolean | undefined; fitViewport?: boolean | undefined; hideWhenDetached?: boolean | undefined; detachedPadding?: number | undefined; arrowPadding?: number | undefined; overflowPadding?: number | undefined; open?: boolean | undefined; defaultOpen?: boolean | undefined; onOpenChange?: (...args: any[]) => any; placeholder?: View; optionValue?: any; optionTextValue?: any; optionDisabled?: any; optionGroupChildren?: any; keyboardDelegate?: any; shouldFocusWrap?: boolean | undefined; selectionBehavior?: any; allowDuplicateSelectionEvents?: boolean | undefined; disallowEmptySelection?: boolean | undefined; closeOnSelection?: boolean | undefined; disallowTypeAhead?: boolean | undefined; virtualized?: boolean | undefined; itemComponent?: Component; sectionComponent?: Component; modal?: boolean | undefined; preventScroll?: boolean | undefined; validationState?: any; readOnly?: boolean | undefined; as?: any }) provides(select)
export component Select.Content(props: { onCloseAutoFocus?: (...args: any[]) => any; onPointerDownOutside?: (...args: any[]) => any; onFocusOutside?: (...args: any[]) => any; onInteractOutside?: (...args: any[]) => any; style?: any; ref?: any; as?: any }) uses(select)
export component Select.Item(props: { item: any; id?: string | undefined; ref?: any; onPointerMove?: any; onPointerDown?: any; onPointerUp?: any; onClick?: any; onKeyDown?: any; onMouseDown?: any; onFocus?: any; as?: any })
export component Select.ItemLabel(props: { id?: string | undefined; as?: any })
export component Select.Listbox(props: { children?: (items: any) => View; scrollRef?: (...args: any[]) => any; scrollToItem?: (...args: any[]) => any; id?: string | undefined; ref?: any; onKeyDown?: any; onMouseDown?: any; onFocusIn?: any; onFocusOut?: any; as?: any }) uses(select)
export component Select.Portal(props: { mount?: Element | undefined; children: View }) uses(select)
export component Select.Trigger(props: { id?: string | undefined; ref?: any; onPointerDown?: any; onClick?: any; onKeyDown?: any; onFocus?: any; onBlur?: any; disabled?: boolean | undefined; type?: string | undefined; tabindex?: string | number | undefined; as?: any }) uses(select)
export component Select.Value(props: { children?: any; id?: string | undefined; as?: any }) uses(select)
