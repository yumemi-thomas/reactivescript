//@ for @kobalte/core ^2.0.0-alpha.4
// Kobalte's Select in rows, as `rx-declare --run --dom @kobalte/core/select` drafts it, kept to the parts the app uses. By hand: the
// root's `onChange` is called later (`handler`) with the option or the options chosen (its props are a union of a single and a
// multiple selection: the library's type says which), and the type of the props an item component is given.
export type SelectRootItemComponentProps<T> = import("@kobalte/core/select").SelectRootItemComponentProps<T>
export context select   // drafted by running: hooks that throw with no provider read it
export type SelectContentProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectContentProps<T>
export type SelectItemLabelProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectItemLabelProps<T>
export type SelectItemProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectItemProps<T>
export type SelectListboxProps<Option, OptGroup = never, T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectListboxProps<Option, OptGroup, T>
export type SelectPortalProps = import("@kobalte/core/select").SelectPortalProps
export type SelectRootProps<Option, OptGroup = never, T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectRootProps<Option, OptGroup, T>
export type SelectTriggerProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectTriggerProps<T>
export type SelectValueProps<Option, T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/select").SelectValueProps<Option, T>
export component Select<Option, OptGroup = never, T extends import("@solidjs/web").ValidComponent = "div">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectRootProps<Option, OptGroup, T>> & { onChange?: handler (value: Option | Option[]) => void; getAnchorRect?: (anchor?: HTMLElement) => { x?: number; y?: number; width?: number; height?: number } | undefined; onOpenChange?: (isOpen: boolean) => void; itemComponent?: Component; sectionComponent?: Component }) provides(select)
export component Select.Content<T extends import("@solidjs/web").ValidComponent = "div">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectContentProps<T>> & { onCloseAutoFocus?: (event: Event) => void; onPointerDownOutside?: (event: import("@solid-primitives/interaction").PointerDownOutsideEvent) => void; onFocusOutside?: (event: import("@solid-primitives/interaction").FocusOutsideEvent) => void; onInteractOutside?: (event: import("@solid-primitives/interaction").InteractOutsideEvent) => void }) uses(select)
export component Select.Item<T extends import("@solidjs/web").ValidComponent = "li">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectItemProps<T>>)
export component Select.ItemLabel<T extends import("@solidjs/web").ValidComponent = "div">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectItemLabelProps<T>>)
export component Select.Listbox<Option = any, OptGroup = never, T extends import("@solidjs/web").ValidComponent = "ul">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectListboxProps<Option, OptGroup, T>> & { children?: (items: Parameters<NonNullable<Parameters<typeof import("@kobalte/core/select").Select["Listbox"]>[0]["children"]>>[0]) => View; scrollRef?: () => HTMLElement | undefined; scrollToItem?: (key: string) => void }) uses(select)
export component Select.Portal(props: SelectPortalProps) uses(select)
export component Select.Trigger<T extends import("@solidjs/web").ValidComponent = "button">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectTriggerProps<T>>) uses(select)
export component Select.Value<Option, T extends import("@solidjs/web").ValidComponent = "span">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, SelectValueProps<Option, T>>) uses(select)
