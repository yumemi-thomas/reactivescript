//@ for @tanstack/solid-query ^6.0.0-rc.6
// @tanstack/solid-query 6 (Solid 2.0) in rows, from rx-declare's draft: the client's context and its provider, a query
// whose `data` waits and throws where it is read (MO-10f), a mutation whose callbacks are called later (MO-10g).
export context queryClient
export component QueryClientProvider(props: { client: any; children?: View }) provides(queryClient)
export pure fn useQueryClient(queryClient?: any): any uses(queryClient)
export pure fn useQuery(ref options: { queryKey: any[]; queryFn: tracked () => Promise<any> }): { data: pending fails(Error) any; isFetching: boolean; status: string } uses(queryClient)
export pure fn useMutation(ref options: { mutationFn: (v: any) => Promise<any>; onSuccess?: handler () => void }): any uses(queryClient)
