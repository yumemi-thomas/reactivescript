// The root route: a route file that is its component. The layout renders its pages with the router's <Outlet />, which
// is in the app's <Frame /> (src/frame.rx), inside the region that holds what a page fails with.
import { Link } from "@tanstack/solid-router"
import { NotFound } from "../people.js"
import { Frame } from "../frame.rx"

export default component Root() {
  <nav><Link to="/">Home</Link> <Link to="/people/$id" params={{ id: "1" }} search={{ tab: "role" }}>Ann</Link> <Link to="/people/$id" params={{ id: "9" }} search={{ tab: "name" }}>Nobody</Link></nav>
  errored fallback(e: NotFound) { <p class="missing">{e.message}</p> } { <Frame /> }
}
