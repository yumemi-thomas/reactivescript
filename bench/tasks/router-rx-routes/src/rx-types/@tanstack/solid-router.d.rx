//@ for @tanstack/solid-router ^2.0.0-rc.10
// @tanstack/solid-router 2.0 (rc) in rows: its link, its hook and its outlet, which read the router's context (the
// app's router.tsx provides it). The types are the package's own.
export context router
export type AnyRouter = import("@tanstack/solid-router").AnyRouter
export type RegisteredRouter<TRegister = Register> = import("@tanstack/solid-router").RegisteredRouter<TRegister>
export type Register = import("@tanstack/solid-router").Register
export component Link(props: { to: string; params?: Parameters<typeof import("@tanstack/solid-router").Link>[0]["params"]; children?: View }) uses(router)
export fn useParams<TRouter extends AnyRouter = RegisteredRouter, const TFrom extends string | undefined = undefined, TStrict extends boolean = true, TThrow extends boolean = true, TSelected = unknown>(opts: import("@tanstack/router-core").StrictOrFrom<TRouter, TFrom, TStrict> & { select?: (params: import("@tanstack/router-core").ResolveUseParams<TRouter, TFrom, TStrict>) => TSelected; shouldThrow?: import("@tanstack/router-core").ThrowConstraint<TStrict, TThrow> }): ref import("@tanstack/router-core").ThrowOrOptional<import("@tanstack/router-core").UseParamsResult<TRouter, TFrom, TStrict, TSelected>, TThrow> uses(router)
export component Outlet(props: {}) uses(router)
// what a route file's own options give its page (the route's `loader`, its `validateSearch`): the draft's rows
export fn useLoaderData<TRouter extends AnyRouter = RegisteredRouter, const TFrom extends string | undefined = undefined, TStrict extends boolean = true, TSelected = unknown>(opts: import("@tanstack/router-core").StrictOrFrom<TRouter, TFrom, TStrict> & { select?: (match: import("@tanstack/router-core").ResolveUseLoaderData<TRouter, TFrom, TStrict>) => TSelected }): ref import("@tanstack/router-core").UseLoaderDataResult<TRouter, TFrom, TStrict, TSelected> uses(router)
export fn useSearch<TRouter extends AnyRouter = RegisteredRouter, const TFrom extends string | undefined = undefined, TStrict extends boolean = true, TThrow extends boolean = true, TSelected = unknown>(opts: import("@tanstack/router-core").StrictOrFrom<TRouter, TFrom, TStrict> & { select?: (state: import("@tanstack/router-core").ResolveUseSearch<TRouter, TFrom, TStrict>) => TSelected; shouldThrow?: import("@tanstack/router-core").ThrowConstraint<TStrict, TThrow> }): ref import("@tanstack/router-core").ThrowOrOptional<import("@tanstack/router-core").UseSearchResult<TRouter, TFrom, TStrict, TSelected>, TThrow> uses(router)
