// An .rx app that uses the package: checked against the `.d.rx` the package ships (09 MO-13), never its source.
import { code, rate, pick, useLabel, Badge, Rate, Offline } from "@bench/rates"
import { createPager } from "@bench/rates/pager"
import { ThemeProvider, theme } from "@bench/rates/theme"
import { Root, Tag, theme as kitTheme } from "@bench/rates/kit"

component Own() {
  provide theme = { accent: "navy" }
  <Badge label="own" />
  <Tag text="tag" />
}

// the kit's context, provided by the kit's name, read by the package's badge (imported from its first entry)
component Kit() {
  provide kitTheme = { accent: "olive" }
  <Badge label="kit" />
}

export default component App() {
  source amount: number := 2
  label = useLabel(amount)
  pager = createPager(amount, 1)
  <ThemeProvider accent="teal">
    <header><Badge label={label} /></header>
    <button class="more" onClick={() => { amount := a => a + 1 }}>more</button>
    <button class="usd" onClick={() => { pick("USD") }}>USD</button>
    <button class="none" onClick={() => { pick("XXX") }}>XXX</button>
    <button class="off" onClick={() => { pick("???") }}>offline</button>
    <button class="again" onClick={() => { refresh rate }}>again</button>
    {errored fallback(e) { <p class="err">failed: {e.message}</p> } {
      {errored fallback(e: Offline) { <p class="offline">offline: {e.code}</p> } {
        {loading fallback { <p class="wait">asking…</p> } { <Rate /> <i class="raw">{code}={rate}</i> <button class="page" onClick={() => { pager.set(3) }}>page {pager.page}: {pager.quote}, {pager.label(pager.page)}</button> }}
      }}
    }}
  </ThemeProvider>
  <footer><Own /></footer>
  <aside><Root accent="maroon"><Tag text="root" /></Root><Kit /></aside>
}
