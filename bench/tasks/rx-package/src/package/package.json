{
  "name": "@bench/rates",
  "version": "1.0.0",
  "description": "A small Solid 2 library written in .rx: a themed badge, an exchange rate that is asked for and can fail, the action that picks the currency, and a primitive over a reference.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "scripts": { "build": "rx-lib" },
  "reactivescript": { "entries": ["src/index.rx", "src/theme.rx", "src/pager.rx", "src/kit/index.rx"] },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/index.server.js",
      "browser": "./dist/index.js",
      "deno": "./dist/index.server.js",
      "node": "./dist/index.server.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "worker": "./dist/theme.server.js",
      "browser": "./dist/theme.js",
      "deno": "./dist/theme.server.js",
      "node": "./dist/theme.server.js",
      "default": "./dist/theme.js"
    },
    "./pager": {
      "types": "./dist/pager.d.ts",
      "worker": "./dist/pager.server.js",
      "browser": "./dist/pager.js",
      "deno": "./dist/pager.server.js",
      "node": "./dist/pager.server.js",
      "default": "./dist/pager.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "worker": "./dist/kit/index.server.js",
      "browser": "./dist/kit/index.js",
      "deno": "./dist/kit/index.server.js",
      "node": "./dist/kit/index.server.js",
      "default": "./dist/kit/index.js"
    },
    "./rates": { "types": "./dist/rates.d.ts", "default": "./dist/rates.js" }
  },
  "peerDependencies": {
    "solid-js": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "@reactivescript/runtime": "*"
  }
}
