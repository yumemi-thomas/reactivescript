// What TanStack Router's file routes do with the app's components (09 MO-14): the root layout is rendered where the
// app's component applies the router's, the pages where the layout applies the router's <Outlet /> (MO-14f: the two
// components the host renders through, imported from JavaScript). From rx-declare --host's draft; by hand: the nesting.
import { App } from "./main.rx"
import { Root, Home, Person } from "./pages.rx"
import { AppRouter } from "./router.tsx"
import { Outlet } from "@tanstack/solid-router"
export default component nests(children in component) = [{ component: App, children: [{ component: Root, children: [{ component: Home }, { component: Person }] }] }]
