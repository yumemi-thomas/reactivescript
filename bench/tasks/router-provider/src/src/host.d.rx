// What TanStack Router's file routes do with pages.rx's components (09 MO-14): every one under the router's provider,
// the pages among the root layout's children. From rx-declare --host's draft; by hand: the nesting.
import { Root, Home, Person } from "./pages.rx"
export context router from "@tanstack/solid-router"
export default component provides(router) nests(children in component) = [{ component: Root, children: [{ component: Home }, { component: Person }] }]
