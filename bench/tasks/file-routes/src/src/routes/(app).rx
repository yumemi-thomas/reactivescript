// The layout of every page: its region shows what a page fails with, and the pages stay reachable beside it.
import { NotFound } from "../people.js"
import { paths } from "../router.ts"
export default component Layout(props: { children?: View }) {
  <nav><a href={paths()}>Home</a> <a href={paths.people("1")}>Ann</a> <a href={paths.people("9")}>Nobody</a></nav>
  errored fallback(e: NotFound) { <p class="missing">{e.message}</p> } {
    <main>{props.children}</main>
  }
}
