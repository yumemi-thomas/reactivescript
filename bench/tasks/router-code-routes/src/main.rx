// Code-based routes on @tanstack/solid-router, as its docs write them: each route is made of a component, the tree of
// routes is a router, and the provider renders the page whose path matches. The provider is in the app's Shell, and the
// app provides a context above it that a page reads.
import { createRootRoute, createRoute, createRouter, Outlet, Link, useParams } from "@tanstack/solid-router"
import { fetchPerson, NotFound } from "./people.js"
import { Shell } from "./shell.rx"

context accent: string

component Root() {
  <nav><Link to="/">Home</Link> <Link to="/people/$id" params={{ id: "1" }}>Ann</Link> <Link to="/people/$id" params={{ id: "9" }}>Nobody</Link></nav>
  <main><Outlet /></main>
}
component Home() {
  <h1 class={use accent}>People</h1>
}
component PersonCard(props: { id: string }) {
  person = await fetchPerson(props.id)
  <h1 class={use accent}>{person.name}</h1>
  <p>{person.role}, #{props.id}</p>
}
// a page holds what it asks: its failure and its wait are shown where it is, and the navigation stays
component Person() {
  params = useParams({ from: "/people/$id" })
  errored fallback(e: NotFound) { <p class="missing">{e.message}</p> } { loading fallback { <p>loading…</p> } { <PersonCard id={params.id} /> } }
}

rootRoute = createRootRoute({ component: Root })
indexRoute = createRoute({ getParentRoute: () => rootRoute, path: "/", component: Home })
personRoute = createRoute({ getParentRoute: () => rootRoute, path: "/people/$id", component: Person })
export router = createRouter({ routeTree: peek rootRoute.addChildren([indexRoute, personRoute]) })   // exported for its type (register.d.ts). `peek`: the tree is made once (E-10)

export default component App() {
  provide accent = "dark"
  <Shell router={router} title="Directory" />
}
