//@ for @tanstack/solid-router ^2.0.0-rc.10
// @tanstack/solid-router 2.0 (rc), code-based routes: rx-declare's draft of what the app imports, as it is —
// `rx-declare @tanstack/solid-router --only Link,Outlet,createRoute,createRootRoute,createRouter,RouterProvider,useParams`:
// those exports' rows, the context their words name and the types they name (the library's whole draft has a row for
// every export, 296 of them). The types' rows, and what known.js says of this release: the router's context, which its
// provider provides and its hooks, link and outlet read, and that the components `createRoute` and `createRootRoute`
// are given are rendered beneath <RouterProvider> (09 MO-11u). The types are the package's own, so the route tree
// registers the router (register.d.ts). No word by hand.
export context router
export type ParsedLocation<TSearchObj extends AnySchema = {  }> = import("@tanstack/solid-router").ParsedLocation<TSearchObj>
export type AnyPathParams = import("@tanstack/solid-router").AnyPathParams
export type ResolveParams<TPath extends string, T = string> = import("@tanstack/solid-router").ResolveParams<TPath, T>
export type AnyContext = import("@tanstack/solid-router").AnyContext
export type ResolveId<TParentRoute, TCustomId extends string, TPath extends string> = import("@tanstack/solid-router").ResolveId<TParentRoute, TCustomId, TPath>
export type TrailingSlashOption = import("@tanstack/solid-router").TrailingSlashOption
export type Constrain<T, TConstraint, TDefault = TConstraint> = import("@tanstack/solid-router").Constrain<T, TConstraint, TDefault>
export type AnySchema = import("@tanstack/solid-router").AnySchema
export type Register = import("@tanstack/solid-router").Register
export type MakeRemountDepsOptionsUnion<TRouteTree extends AnyRoute = RegisteredRouter["routeTree"]> = import("@tanstack/solid-router").MakeRemountDepsOptionsUnion<TRouteTree>
export type RouteOptions<TRegister, TParentRoute extends AnyRoute = AnyRoute, TId extends string = string, TCustomId extends string = string, TFullPath extends string = string, TPath extends string = string, TSearchValidator = undefined, TParams = AnyPathParams, TLoaderDeps extends Record<string, any> = {  }, TLoaderFn = undefined, TRouterContext = {  }, TRouteContextFn = AnyContext, TBeforeLoadFn = AnyContext, TSSR = unknown, TServerMiddlewares = unknown, THandlers = undefined> = import("@tanstack/solid-router").RouteOptions<TRegister, TParentRoute, TId, TCustomId, TFullPath, TPath, TSearchValidator, TParams, TLoaderDeps, TLoaderFn, TRouterContext, TRouteContextFn, TBeforeLoadFn, TSSR, TServerMiddlewares, THandlers>
export type RootRouteOptions<TRegister = unknown, TSearchValidator = undefined, TRouterContext = {  }, TRouteContextFn = AnyContext, TBeforeLoadFn = AnyContext, TLoaderDeps extends Record<string, any> = {  }, TLoaderFn = undefined, TSSR = unknown, TServerMiddlewares = unknown, THandlers = undefined> = import("@tanstack/solid-router").RootRouteOptions<TRegister, TSearchValidator, TRouterContext, TRouteContextFn, TBeforeLoadFn, TLoaderDeps, TLoaderFn, TSSR, TServerMiddlewares, THandlers>
export type AnyRoute = import("@tanstack/solid-router").AnyRoute
export type ResolveFullPath<TParentRoute extends AnyRoute, TPath extends string, TPrefixed = import("@tanstack/router-core").RoutePrefix<TParentRoute["fullPath"], TPath>> = import("@tanstack/solid-router").ResolveFullPath<TParentRoute, TPath, TPrefixed>
export type RouteConstraints = import("@tanstack/solid-router").RouteConstraints
export type AnyRouter = import("@tanstack/solid-router").AnyRouter
export type RegisteredRouter<TRegister = Register> = import("@tanstack/solid-router").RegisteredRouter<TRegister>
export type RouterConstructorOptions<TRouteTree extends AnyRoute, TTrailingSlashOption extends TrailingSlashOption, TDefaultStructuralSharingOption extends boolean, TRouterHistory extends RouterHistory, TDehydrated extends Record<string, any>> = import("@tanstack/solid-router").RouterConstructorOptions<TRouteTree, TTrailingSlashOption, TDefaultStructuralSharingOption, TRouterHistory, TDehydrated>
export type RouterHistory = import("@tanstack/solid-router").RouterHistory
export component Outlet(props: {  }) uses(router)
export pure fn createRoute<TRegister = unknown, TParentRoute extends RouteConstraints["TParentRoute"] = AnyRoute, TPath extends RouteConstraints["TPath"] = "/", TFullPath extends RouteConstraints["TFullPath"] = ResolveFullPath<TParentRoute, TPath>, TCustomId extends RouteConstraints["TCustomId"] = string, TId extends RouteConstraints["TId"] = ResolveId<TParentRoute, TCustomId, TPath>, TSearchValidator = undefined, TParams = ResolveParams<TPath>, TRouteContextFn = AnyContext, TBeforeLoadFn = AnyContext, TLoaderDeps extends Record<string, any> = {  }, TLoaderFn = undefined, TChildren = unknown, TSSR = unknown, THandlers = undefined>(options: RouteOptions<TRegister, TParentRoute, TId, TCustomId, TFullPath, TPath, TSearchValidator, TParams, TLoaderDeps, TLoaderFn, AnyContext, TRouteContextFn, TBeforeLoadFn, TSSR, THandlers>): import("@tanstack/solid-router").Route<TRegister, TParentRoute, TPath, TFullPath, TCustomId, TId, TSearchValidator, TParams, AnyContext, TRouteContextFn, TBeforeLoadFn, TLoaderDeps, TLoaderFn, TChildren, unknown, TSSR, THandlers> instantiates renders(RouterProvider)
export pure fn createRootRoute<TRegister = Register, TSearchValidator = undefined, TRouterContext = {  }, TRouteContextFn = AnyContext, TBeforeLoadFn = AnyContext, TLoaderDeps extends Record<string, any> = {  }, TLoaderFn = undefined, TSSR = unknown, THandlers = undefined>(options?: RootRouteOptions<TRegister, TSearchValidator, TRouterContext, TRouteContextFn, TBeforeLoadFn, TLoaderDeps, TLoaderFn, TSSR, THandlers>): import("@tanstack/solid-router").RootRoute<TRegister, TSearchValidator, TRouterContext, TRouteContextFn, TBeforeLoadFn, TLoaderDeps, TLoaderFn, unknown, unknown, TSSR, THandlers> instantiates renders(RouterProvider)
export fn createRouter<TRouteTree extends AnyRoute, TTrailingSlashOption extends TrailingSlashOption = "never", TDefaultStructuralSharingOption extends boolean = false, TRouterHistory extends RouterHistory = RouterHistory, TDehydrated extends Record<string, any> = Record<string, any>>(options: undefined extends number ? "strictNullChecks must be enabled in tsconfig.json" : RouterConstructorOptions<TRouteTree, TTrailingSlashOption, TDefaultStructuralSharingOption, TRouterHistory, TDehydrated>): import("@tanstack/router-core").RouterCore<TRouteTree, TTrailingSlashOption, TDefaultStructuralSharingOption, TRouterHistory, TDehydrated> instantiates
export component RouterProvider<TRouter extends AnyRouter = RegisteredRouter, TDehydrated extends Record<string, any> = Record<string, any>>(props: RouterProps<TRouter, TDehydrated> & { stringifySearch?: (searchObj: Record<string, any>) => string; parseSearch?: (searchStr: string) => Record<string, any>; dehydrate?: () => import("@tanstack/router-core").Awaitable<Constrain<TDehydrated, import("@tanstack/router-core").ValidateSerializable<TDehydrated, import("@tanstack/router-core").RegisteredSerializableInput<Register>>>>; hydrate?: (dehydrated: TDehydrated) => import("@tanstack/router-core").Awaitable<void>; defaultRemountDeps?: (opts: MakeRemountDepsOptionsUnion<TRouter["routeTree"]>) => any; getScrollRestorationKey?: (location: ParsedLocation) => string; defaultNotFoundComponent?: (props: { data?: unknown; isNotFound: boolean; routeId: any; }) => any; Wrap?: Component; InnerWrap?: Component; defaultOnCatch?: (error_: Error) => void }) provides(router)
export type RouterProps<TRouter extends AnyRouter = RegisteredRouter, TDehydrated extends Record<string, any> = Record<string, any>> = import("@tanstack/solid-router").RouterProps<TRouter, TDehydrated>
export pure fn useParams<TRouter extends AnyRouter = RegisteredRouter, const TFrom extends string | undefined = undefined, TStrict extends boolean = true, TThrow extends boolean = true, TSelected = unknown>(opts: import("@tanstack/router-core").StrictOrFrom<TRouter, TFrom, TStrict> & { select?: (params: import("@tanstack/router-core").ResolveUseParams<TRouter, TFrom, TStrict>) => TSelected; shouldThrow?: import("@tanstack/router-core").ThrowConstraint<TStrict, TThrow> }): ref import("@tanstack/router-core").ThrowOrOptional<import("@tanstack/router-core").UseParamsResult<TRouter, TFrom, TStrict, TSelected>, TThrow> uses(router)
export component Link(props: { to: string; params?: Parameters<typeof import("@tanstack/solid-router").Link>[0]["params"]; children?: View }) uses(router)
