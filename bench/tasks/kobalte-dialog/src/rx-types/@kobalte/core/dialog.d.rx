//@ for @kobalte/core ^2.0.0-alpha.4
// Kobalte's Dialog in rows, as `rx-declare --dom @kobalte/core/dialog` drafts it (the parts read the root's context). The types are the package's own.
export context dialog   // drafted by running: hooks that throw with no provider read it
export type DialogCloseButtonProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/dialog").DialogCloseButtonProps<T>
export type DialogContentProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/dialog").DialogContentProps<T>
export type DialogDescriptionProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/dialog").DialogDescriptionProps<T>
export type DialogOverlayProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/dialog").DialogOverlayProps<T>
export type DialogPortalProps = import("@kobalte/core/dialog").DialogPortalProps
export type DialogRootProps = import("@kobalte/core/dialog").DialogRootProps
export type DialogTitleProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/dialog").DialogTitleProps<T>
export type DialogTriggerProps<T extends import("@solidjs/web").ValidComponent | HTMLElement = HTMLElement> = import("@kobalte/core/dialog").DialogTriggerProps<T>
export component Dialog(props: DialogRootProps & { onOpenChange?: handler (isOpen: boolean) => void }) provides(dialog)
export component Dialog.CloseButton<T extends import("@solidjs/web").ValidComponent = "button">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, DialogCloseButtonProps<T>>) uses(dialog)
export component Dialog.Content<T extends import("@solidjs/web").ValidComponent = "div">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, DialogContentProps<T>> & { onOpenAutoFocus?: handler (event: Event) => void; onCloseAutoFocus?: handler (event: Event) => void; onEscapeKeyDown?: handler (event: KeyboardEvent) => void; onPointerDownOutside?: handler (event: import("@solid-primitives/interaction").PointerDownOutsideEvent) => void; onFocusOutside?: handler (event: import("@solid-primitives/interaction").FocusOutsideEvent) => void; onInteractOutside?: handler (event: import("@solid-primitives/interaction").InteractOutsideEvent) => void }) uses(dialog)
export component Dialog.Description<T extends import("@solidjs/web").ValidComponent = "p">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, DialogDescriptionProps<T>>) uses(dialog)
export component Dialog.Overlay<T extends import("@solidjs/web").ValidComponent = "div">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, DialogOverlayProps<T>>) uses(dialog)
export component Dialog.Portal(props: DialogPortalProps) uses(dialog)
export component Dialog.Title<T extends import("@solidjs/web").ValidComponent = "h2">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, DialogTitleProps<T>>) uses(dialog)
export component Dialog.Trigger<T extends import("@solidjs/web").ValidComponent = "button">(props: import("@kobalte/core/polymorphic").PolymorphicProps<T, DialogTriggerProps<T>>) uses(dialog)
