//@ for @solid-primitives/sortable ^1.0.0
export type Comparator<T> = import("@solid-primitives/sortable").Comparator<T>
export type CreateSortedOptions = import("@solid-primitives/sortable").CreateSortedOptions
export pure fn createSorted<T>(ref list: T[], ref comparator?: Comparator<T>, options?: CreateSortedOptions): ref T[]
export pure fn by<T, K>(accessor: (item: T) => K, comparator?: (a: K, b: K) => number): ((a: T, b: T) => number)
