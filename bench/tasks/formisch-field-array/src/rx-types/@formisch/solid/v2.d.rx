//@ for @formisch/solid ^1.3.0
// Formisch's Solid 2 build in rows, as rx-declare drafts it, kept to what the form uses: the form is made once
// (`pure`), and a submit is called later (`handler`). The types are the package's own.
export type FormSchema = import("@formisch/solid/v2").FormSchema
export type FormStore<TSchema extends FormSchema = FormSchema> = import("@formisch/solid/v2").FormStore<TSchema>
export type FormConfig<TSchema extends FormSchema = FormSchema> = import("@formisch/solid/v2").FormConfig<TSchema>
export component Field(props: { of: Parameters<typeof import("@formisch/solid/v2").Field>[0]["of"]; path: Parameters<typeof import("@formisch/solid/v2").Field>[0]["path"]; children: (store: Parameters<Parameters<typeof import("@formisch/solid/v2").Field>[0]["children"]>[0]) => View })
export component FieldArray(props: { of: Parameters<typeof import("@formisch/solid/v2").FieldArray>[0]["of"]; path: Parameters<typeof import("@formisch/solid/v2").FieldArray>[0]["path"]; children: (store: Parameters<Parameters<typeof import("@formisch/solid/v2").FieldArray>[0]["children"]>[0]) => View })
export component Form<TSchema extends FormSchema>(props: { of: FormStore<TSchema>; children: View; onSubmit: handler (output: import("valibot").InferOutput<TSchema>, event: SubmitEvent) => unknown })
export pure fn createForm<TSchema extends FormSchema>(config: FormConfig<TSchema>): FormStore<TSchema> instantiates
export fn insert(form: Parameters<typeof import("@formisch/solid/v2").insert>[0], config: Parameters<typeof import("@formisch/solid/v2").insert>[1]): void
export fn move(form: Parameters<typeof import("@formisch/solid/v2").move>[0], config: Parameters<typeof import("@formisch/solid/v2").move>[1]): void
export fn remove(form: Parameters<typeof import("@formisch/solid/v2").remove>[0], config: Parameters<typeof import("@formisch/solid/v2").remove>[1]): void
