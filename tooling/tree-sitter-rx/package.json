{
  "name": "tree-sitter-rx",
  "version": "0.1.0",
  "description": "ReactiveScript (.rx) grammar for tree-sitter",
  "private": true,
  "license": "MIT",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse",
    "parse:repo": "git ls-files ':(top)*.rx' > .rx-files && tree-sitter parse -q -s --paths .rx-files",
    "query": "tree-sitter query queries/highlights.scm"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.27.2",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-typescript": "0.23.2"
  }
}
